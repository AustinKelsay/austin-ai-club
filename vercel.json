{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/meetups/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/calendar",
      "destination": "/index.html"
    },
    {
      "source": "/wiki",
      "destination": "/index.html"
    },
    {
      "source": "/wiki/:id",
      "destination": "/index.html"
    },
    {
      "source": "/submit-link",
      "destination": "/index.html"
    },
    {
      "source": "/submit-showcase",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "austinai.club"
        }
      ],
      "destination": "https://sovereignai.club/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.austinai.club"
        }
      ],
      "destination": "https://sovereignai.club/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.sovereignai.club"
        }
      ],
      "destination": "https://sovereignai.club/:path*",
      "permanent": true
    }
  ]
}
